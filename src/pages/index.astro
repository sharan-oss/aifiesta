---
// Home: sales video (VSL) in the hero and a lead popup before checkout. This was variant B of the
// Home A/B test and won, so it is now the only Home. lp stays "home-b" so reports stay comparable.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ModelStrip from '../components/ModelStrip.astro';
import Benefits from '../components/Benefits.astro';
import Features from '../components/Features.astro';
import Compare from '../components/Compare.astro';
import Founder from '../components/Founder.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import LeadPopup from '../components/LeadPopup.astro';
import SaleBar from '../components/SaleBar.astro';
import { VSL_MEDIA_ID } from '../data/content';
---
<Layout title="AI Fiesta · ChatGPT, Claude, Gemini and 100+ AI models in one subscription" lp="home-b">
  <SaleBar />
  <main>
    <Hero vsl={VSL_MEDIA_ID} />
    <ModelStrip />
    <Pricing />
    <Benefits />
    <Features />
    <Compare />
    <Founder />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
  <StickyCta />
  <LeadPopup variant="b" />
</Layout>
