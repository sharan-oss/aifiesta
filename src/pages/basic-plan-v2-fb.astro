---
import Layout from '../layouts/LayoutV2.astro';
import Hero from '../components/v2/Hero.astro';
import ModelStrip from '../components/v2/ModelStrip.astro';
import Pricing from '../components/v2/Pricing.astro';
import DomainBonus from '../components/DomainBonus.astro';
import Benefits from '../components/v2/Benefits.astro';
import Features from '../components/v2/Features.astro';
import Compare from '../components/v2/Compare.astro';
import BestFeatures from '../components/v2/BestFeatures.astro';
import Testimonials from '../components/v2/Testimonials.astro';
import Audience from '../components/v2/Audience.astro';
import Why from '../components/v2/Why.astro';
import Faq from '../components/v2/Faq.astro';
import StickyCta from '../components/v2/StickyCta.astro';
---
<Layout title="AI Fiesta - 100+ Premium AI Models in One Subscription">
  <main>
    <Hero />
    <ModelStrip />
    <DomainBonus variant="v2" />
    <Pricing />
    <Benefits />
    <Features />
    <Compare />
    <BestFeatures />
    <Testimonials />
    <Audience />
    <Why />
    <Faq />
