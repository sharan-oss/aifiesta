---
// Home, variant B of the A/B test: sales video (VSL) in the hero instead of Dhruv's photo, and a
// lead popup before checkout. Served at "/" to half of visitors by middleware.js (the URL stays
// "/"); /home-b itself only exists so the rewrite has a target, hence the canonical to "/".
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ModelStrip from '../components/ModelStrip.astro';
import Benefits from '../components/Benefits.astro';
import Features from '../components/Features.astro';
import Compare from '../components/Compare.astro';
import Founder from '../components/Founder.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import LeadPopup from '../components/LeadPopup.astro';
import { VSL_MEDIA_ID } from '../data/content';
---
<Layout title="AI Fiesta · ChatGPT, Claude, Gemini and 100+ AI models in one subscription" lp="home-b" canonical="https://super.aifiesta.ai/">
  <main>
    <Hero vsl={VSL_MEDIA_ID} />
    <ModelStrip />
    <Pricing />
    <Benefits />
    <Features />
    <Compare />
    <Founder />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
  <StickyCta />
  <LeadPopup variant="b" />
</Layout>
