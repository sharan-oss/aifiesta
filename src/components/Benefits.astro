---
import { benefits, CTA, PRICING_HREF } from '../data/content';
---
<section class="wrap ben">
  <h2>AIFiesta - India ka AI.</h2>
  <ul>
    {benefits.map((b) => (
      <li>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10l4.3 4.3L17 4.7" stroke="#5146D9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p>{b}</p>
      </li>
    ))}
  </ul>
  <a class="btn btn--block" href={PRICING_HREF} data-cta="benefits">{CTA}</a>
</section>
<style>
  .ben { padding-block: 24px var(--section-y); display: grid; gap: 20px; max-width: 640px; }
  h2 { font-size: clamp(25px, 4vw, 32px); font-weight: 700; text-align: center; }
  ul { display: grid; gap: 16px; margin-block: 0 8px; }
  li { display: flex; gap: 12px; }
  svg { flex: none; margin-top: 2px; }
  p { font-size: 14px; font-weight: 700; color: var(--muted); }
  @media (min-width: 768px) { p { font-size: 16px; } ul { gap: 20px; } }
</style>
