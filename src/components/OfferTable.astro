---
// "Get 4x of everything" table for the yearly plan card. The slot (rollover note) sits
// between the table and the bonus-token footnote. `domain` adds the free-domain bonus line
// (pages without their own domain section). `layout="grid"` swaps the table for six compact
// cells (1st-month amount, then the monthly amount), which halves the card's height.
import { offer } from '../data/content';
interface Props { theme?: 'light' | 'dark'; domain?: boolean; layout?: 'table' | 'grid' }
const { theme = 'light', domain = false, layout = 'table' } = Astro.props;
const fmt = (v: string) => (/^\d{4,}$/.test(v) ? Number(v).toLocaleString('en-IN') : v);
const icons: Record<string, string> = {
  tokens: '<circle cx="7" cy="14" r="4.4"/><circle cx="14" cy="7" r="4.4"/>',
  image: '<rect x="2.6" y="2.6" width="15.8" height="15.8" rx="2"/><path d="M2.6 14.9l5.3-5.3 3.5 3.5 3.5-4.4 3.5 4.4"/>',
  video: '<rect x="2.6" y="7.9" width="15.8" height="10.5" rx="2"/><path d="M2.6 7.9l-.9-4.4 15.8-2.6.9 4.4z"/>',
  globe: '<circle cx="10.5" cy="10.5" r="7.9"/><ellipse cx="10.5" cy="10.5" rx="3.5" ry="7.9"/><path d="M2.6 10.5h15.8"/>',
  slides: '<path d="M1.8 2.6h17.5M3.5 2.6V14h14V2.6M10.5 14v4.4M10.5 14l-4.4 4.4M10.5 14l4.4 4.4"/>',
  research: '<path d="M2.6 8.8l14-4.4 1.8 5.2-14 4.4zM10.5 12.3L7 18.4M11.4 11.4l3.5 6.1"/>',
};
---
<div class:list={['offer4x', theme]}>
  <p class="banner">
    <span class="shine" aria-hidden="true"></span>
    <span class="gift"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12v9M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><g class="lid"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v4M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></g></svg>{[0, 1, 2, 3, 4, 5].map((i) => <i class="spark" style={`--a:${i * 60 - 30}deg`} aria-hidden="true" />)}</span>
    <span class="head">
      <span>Get <b data-count>{offer.multiple}</b> of everything</span>
      {domain && <span class="plus">+ Free custom domain <span class="nw">for a year</span> <small>(worth ₹1,500)</small></span>}
    </span>
  </p>
  {layout === 'grid' ? (
    <div class="cells">
      <p class="cap">In your 1st month<span>*</span></p>
      <ul>
        {offer.rows.map(([label, usual, now, ic], i) => (
          <li>
            <b class="val" style={`--i:${i}`}>{fmt(now)}</b>
            <span class="lbl">{label}</span>
          </li>
        ))}
      </ul>
      <p class="after">Every month after: {offer.rows.map(([label, usual]) => `${fmt(usual)} ${label.toLowerCase()}`).join(', ')}.</p>
    </div>
  ) : (
  <table>
    <thead>
      <tr><th scope="col">In your plan</th><th scope="col">Every month</th><th scope="col" class="now">Current Offer*<small>1st month</small></th></tr>
    </thead>
    <tbody>
      {offer.rows.map(([label, usual, now, ic, info], i) => (
        <tr>
          <th scope="row">
            <span class="lbl">
              <svg viewBox="0 0 21 21" fill="none" stroke="currentColor" stroke-width="1.575" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[ic]} />
              {label}
              {info && (
                <span class="info">
                  <button type="button" aria-label={`${label} info`} aria-expanded="false" data-info><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></button>
                  <span class="tip" role="tooltip" hidden>{info}</span>
                </span>
              )}
            </span>
          </th>
          <td>{usual}</td>
          <td><b class="val" style={`--i:${i}`}>{now}</b></td>
        </tr>
      ))}
    </tbody>
  </table>
  )}
  <slot />
  <p class="fine">{offer.footnote} · {layout === 'grid' && 'Video counts vary by model and settings · '}<a href={offer.policyHref} target="_blank" rel="noopener">{offer.policy}</a></p>
</div>
<style>
  .offer4x { --accent: #3f9b6a; --chip: #e6f4ea; --rule: var(--line); --soft: var(--muted); display: grid; gap: 12px; }
  .dark { --accent: #80dca9; --chip: rgba(128,220,169,.14); --rule: #35304c; --soft: #cbd0de; }
  .banner { display: flex; align-items: center; gap: 14px; padding: 10px 14px 10px 10px; border-radius: 16px; background: var(--chip); font-size: 19px; font-weight: 700; }
  .banner b { color: var(--accent); font-size: 1.25em; }
  .head { display: grid; gap: 2px; }
  .plus { font-size: 15px; font-weight: 600; color: var(--accent); }
  .plus small { font-size: 13px; font-weight: 500; color: var(--soft); white-space: nowrap; }
  .plus .nw { white-space: nowrap; }
  .gift { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: #fff; color: #3f9b6a; box-shadow: 0 0 0 4px rgba(63,155,106,.15); }
  .gift svg { width: 24px; height: 24px; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { padding: 10px 0; border-bottom: 1px solid var(--rule); text-align: center; font-weight: 500; }
  tbody tr:last-child > * { border-bottom: 0; }
  th:first-child { text-align: left; }
  thead th { font-size: 14px; color: var(--soft); vertical-align: bottom; }
  thead .now { color: var(--accent); font-weight: 600; }
  thead small { display: block; font-size: 11px; color: var(--soft); font-weight: 500; }
  td { color: var(--soft); width: 26%; }
  td b { display: inline-block; min-width: 64px; padding: 6px 10px; border-radius: 99px; background: var(--chip); color: inherit; font-weight: 700; }
  .light td b { color: var(--ink); }
  .dark td b { color: #fff; }
  .lbl { display: flex; align-items: center; gap: 8px; }
  /* Grid layout */
  .cap { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .cells ul { display: grid; grid-template-columns: repeat(3, 1fr); }
  .cells li { display: grid; gap: 2px; justify-items: center; text-align: center; min-width: 0; padding: 14px 2px; border-bottom: 1px solid var(--rule); }
  .cells li:nth-child(n+4) { border-bottom: 0; }
  .cells .lbl { display: block; font-size: 13px; font-weight: 500; color: var(--soft); }
  .cells .val { display: inline-block; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .light .cells .val { color: var(--ink); }
  .dark .cells .val { color: #fff; }
  .after { font-size: 12px; color: var(--soft); text-align: center; text-wrap: balance; }
  .lbl > svg { width: 20px; height: 20px; flex: none; }
  .info { position: relative; display: inline-flex; }
  .info button { display: grid; place-items: center; width: 18px; height: 18px; padding: 0; border: 0; background: none; color: var(--soft); cursor: pointer; }
  .info button svg { width: 15px; height: 15px; }
  .tip { position: absolute; bottom: calc(100% + 8px); left: -6px; z-index: 5; width: max-content; max-width: 196px; padding: 8px 12px; border: 1px solid #9fd9bb; border-radius: 8px; background: #fff; color: #52525b; font-size: 12px; line-height: 1.45; font-weight: 400; text-align: left; box-shadow: 0 10px 24px -8px rgba(15,23,20,.12); }
  .info:hover .tip { display: block; }
  /* Reveal: plays once when the banner scrolls into view (JS adds .armed, then .go).
     Without JS or with reduced motion nothing is hidden or moved. */
  .banner { position: relative; }
  .shine { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; pointer-events: none; }
  .shine::after { content: ''; position: absolute; inset: -20% auto -20% 0; width: 40%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.75), transparent); transform: translateX(-150%) skewX(-18deg); }
  .dark .shine::after { background: linear-gradient(100deg, transparent, rgba(255,255,255,.18), transparent); }
  .gift { position: relative; }
  .gift::after { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--accent); opacity: 0; pointer-events: none; }
  .gift svg { overflow: visible; }
  .lid { transform-box: fill-box; transform-origin: 0% 100%; }
  .spark { position: absolute; top: 50%; left: 50%; width: 6px; height: 6px; margin: -3px; border-radius: 50%; background: var(--accent); opacity: 0; }
  .spark:nth-of-type(even) { background: #f5b301; width: 5px; height: 5px; }
  .banner b { display: inline-block; }
  .armed:not(.go) .plus, .armed:not(.go) .val { opacity: 0; }
  .go .gift { animation: wiggle .6s cubic-bezier(.36,.07,.19,.97) both; }
  .go .lid { animation: lid .7s cubic-bezier(.16,1,.3,1) .15s both; }
  .go .spark { animation: spark .8s cubic-bezier(.16,1,.3,1) .3s; }
  .go .gift::after { animation: ring 2.4s cubic-bezier(.16,1,.3,1) 1s infinite; }
  .go .banner b.punch { animation: punch .45s cubic-bezier(.16,1,.3,1); }
  .go .plus { animation: rise .5s cubic-bezier(.16,1,.3,1) .55s both; }
  .go .shine::after { animation: shine 4.5s cubic-bezier(.25,1,.5,1) .7s infinite; }
  .go .val { animation: pop .45s cubic-bezier(.16,1,.3,1) calc(.8s + var(--i) * 70ms) both; }
  @keyframes wiggle { 15% { transform: rotate(-12deg) scale(1.08); } 35% { transform: rotate(10deg) scale(1.08); } 55% { transform: rotate(-6deg); } 75% { transform: rotate(3deg); } }
  @keyframes lid { 40% { transform: translateY(-5px) rotate(-14deg); } }
  @keyframes spark { from { opacity: 1; transform: rotate(var(--a)) translateX(10px) scale(1); } to { opacity: 0; transform: rotate(var(--a)) translateX(40px) scale(.3); } }
  @keyframes ring { from { opacity: .55; transform: scale(1); } to { opacity: 0; transform: scale(1.45); } }
  @keyframes punch { 40% { transform: scale(1.25) rotate(-4deg); } }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  @keyframes shine { 0% { transform: translateX(-150%) skewX(-18deg); } 30%, 100% { transform: translateX(300%) skewX(-18deg); } }
  @keyframes pop { from { opacity: 0; transform: scale(.6); } }
  @media (prefers-reduced-motion: reduce) {
    .go *, .go *::after { animation: none !important; }
  }
  .fine { text-align: center; font-size: 12px; color: var(--soft); }
  .fine a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>
<script>
  // Info tips open on tap (hover covers mouse users); tapping anywhere else closes them.
  const tips = [...document.querySelectorAll<HTMLButtonElement>('[data-info]')];
  const closeAll = () => tips.forEach((b) => { b.setAttribute('aria-expanded', 'false'); (b.nextElementSibling as HTMLElement).hidden = true; });
  tips.forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    closeAll();
    b.setAttribute('aria-expanded', String(open));
    (b.nextElementSibling as HTMLElement).hidden = !open;
  }));
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-info]')) closeAll(); });

  // "4x" banner reveal: counts 1x -> 4x, pops the gift, then the offer column fills in.
  // Plays once per table when its banner is in view; skipped for reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const box = (e.target as HTMLElement).closest<HTMLElement>('.offer4x')!;
      box.classList.add('go');
      const b = box.querySelector<HTMLElement>('[data-count]');
      const m = b?.textContent?.match(/^(\d+)(.*)$/);
      if (!b || !m) return;
      const [, end, unit] = m;
      let n = 1;
      b.textContent = n + unit;
      const t = setInterval(() => {
        b.textContent = ++n + unit;
        if (n >= +end) { clearInterval(t); b.classList.add('punch'); }
      }, 140);
    }), { threshold: 0.9 });
    document.querySelectorAll<HTMLElement>('.offer4x').forEach((el) => { el.classList.add('armed'); io.observe(el.querySelector('.banner')!); });
  }
</script>
