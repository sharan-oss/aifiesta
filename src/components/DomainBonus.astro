---
interface Props { variant?: 'v1' | 'v2' }
const { variant = 'v1' } = Astro.props;
// Scrolls to the pricing card; only that card goes to payment.
const href = '#pricing';
const steps = [
  'Get the annual plan for ₹7,999.',
  'Build your first website in Website Builder.',
  'Claim your free domain when you publish.',
];
---
<section class:list={['bonus', variant]} id="domain-bonus">
  <div class="wrap">
    <div class="card">
      <img class="gift" src="/images/gift.png" alt="" width="84" height="84" />
      <p class="tag">Limited-time bonus</p>
      <h2>Get your own domain, free for a year</h2>
      <p class="lead">Every AI Fiesta annual plan now includes a free custom domain worth ₹1,500. Build your website with AI, and go live on a name that’s yours.</p>
      <h3>How it works</h3>
      <ol>
        {steps.map((s, i) => <li><span>{i + 1}</span>{s}</li>)}
      </ol>
      <a class="cta" href={href} data-cta="domain-bonus">Get AI Fiesta + free domain</a>
    </div>
  </div>
</section>
<style>
  .bonus { padding-block: 36px 0; }
  .bonus.v1 { background: var(--brand-tint); padding-block: var(--section-y) 0; }
  .card { max-width: 560px; margin-inline: auto; text-align: center; background: #fff; border: 1px solid rgba(3,0,37,.09); border-radius: 24px; padding: 28px 20px; display: grid; justify-items: center; gap: 12px; box-shadow: 0 8px 20px rgba(36,32,61,.07); }
  .gift { width: 84px; height: 84px; object-fit: contain; mix-blend-mode: multiply; }
  .tag { background: #fff0f3; color: #d81e5a; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 6px 12px; border-radius: 99px; }
  h2 { font-size: clamp(24px, 4vw, 32px); line-height: 1.15; font-weight: 700; letter-spacing: -0.01em; }
  .lead { font-size: 15px; opacity: .8; max-width: 440px; }
  h3 { font-size: 15px; font-weight: 700; margin-top: 8px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; text-align: left; width: 100%; max-width: 380px; }
  li { display: flex; gap: 12px; align-items: center; font-size: 15px; font-weight: 500; }
  li span { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #030025; color: #fff; font-size: 13px; font-weight: 700; display: grid; place-items: center; }
  .cta { margin-top: 8px; width: 100%; max-width: 380px; padding: 16px 20px; border-radius: 50px; font-weight: 700; font-size: 15px; color: #fff; background: linear-gradient(to right, #f0145a, #d81e9c 30%, #a020d0 60%, #7b2ff7); transition: transform .15s ease, filter .15s ease; }
  .cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .v1 .cta { background: var(--brand); border-radius: 12px; }
  @media (min-width: 768px) { .bonus { padding-block: 64px 0; } .card { padding: 36px 32px; } }
</style>
