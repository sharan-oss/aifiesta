---
import { modelGroups } from '../data/models-list';
---
<button type="button" class="explore" data-models-open aria-haspopup="dialog">
  <svg class="explore__ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>
  Explore AI models
  <svg class="explore__go" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
</button>
<dialog class="mdl" data-models-dialog aria-labelledby="mdl-title">
  <div class="mdl__head">
    <h2 id="mdl-title">AI models, one subscription</h2>
    <button type="button" class="mdl__x" data-models-close aria-label="Close">×</button>
  </div>
  <input type="search" class="mdl__search" data-models-search placeholder="Search models, e.g. Claude, GPT, Veo" aria-label="Search AI models" autocomplete="off" />
  <div class="mdl__body" data-models-body>
    {modelGroups.map((g) => (
      <section data-group>
        <h3>{g.title}</h3>
        <ul>
          {g.models.map((m) => <li data-name={m.toLowerCase()}>{m}</li>)}
        </ul>
      </section>
    ))}
    <p class="mdl__none" data-models-none hidden>No models match your search.</p>
  </div>
</dialog>
<style>
  .explore { display: flex; align-items: center; justify-content: center; gap: 10px; width: fit-content; margin: 0 auto 22px; height: 52px; padding-inline: 22px 16px; background: var(--brand-soft); color: var(--ink); border: 2px solid var(--brand); border-radius: 999px; font: inherit; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 16px -8px rgba(80,60,220,.5); transition: transform .15s ease, background .15s ease; }
  .explore__ico { color: var(--brand); }
  .explore__go { flex: none; width: 28px; height: 28px; padding: 5px; border-radius: 50%; background: var(--brand); color: #fff; transition: transform .15s ease; }
  .explore:hover { background: #fff; transform: translateY(-1px); }
  .explore:hover .explore__go { transform: translateX(2px); }
  .explore:focus-visible, .mdl__x:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .mdl { width: min(560px, calc(100vw - 24px)); max-height: min(640px, calc(100dvh - 24px)); margin: auto; padding: 0; border: 0; border-radius: 20px; background: #fff; color: var(--ink); box-shadow: 0 30px 80px rgba(11,18,32,.35); text-align: left; }
  .mdl[open] { display: flex; flex-direction: column; }
  .mdl::backdrop { background: rgba(36,32,61,.55); }
  .mdl__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px 8px; }
  .mdl__head h2 { font-size: 19px; font-weight: 700; }
  .mdl__x { width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--brand-soft); font-size: 22px; line-height: 1; cursor: pointer; color: var(--ink); }
  .mdl__search { flex: none; display: block; box-sizing: border-box; width: calc(100% - 40px); min-width: 0; margin: 8px 20px 12px; height: 48px; padding: 0 16px; border: 1px solid var(--line); border-radius: 12px; -webkit-appearance: none; appearance: none; font: inherit; font-size: 16px; line-height: 48px; background: var(--brand-soft); color: var(--ink); }
  .mdl__search::placeholder { color: var(--muted); opacity: 1; }
  .mdl__search:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(80,60,220,.18); background: #fff; }
  .mdl__body { overflow-y: auto; overscroll-behavior: contain; padding: 0 20px 20px; display: grid; gap: 18px; }
  .mdl__body h3 { position: sticky; top: 0; background: #fff; padding-block: 6px; font-size: 14px; font-weight: 700; color: var(--muted); display: flex; gap: 8px; align-items: center; }
  .mdl__body ul { display: grid; gap: 6px; }
  .mdl__body li { display: flex; gap: 10px; font-size: 15px; font-weight: 500; padding: 9px 12px; background: var(--brand-soft); border-radius: 10px; }
  .mdl [hidden] { display: none; }
  .mdl__none { text-align: center; color: var(--muted); padding-block: 24px; }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-models-dialog]');
  const search = document.querySelector<HTMLInputElement>('[data-models-search]');
  if (dlg && search) {
    const items = [...dlg.querySelectorAll<HTMLElement>('li[data-name]')];
    const groups = [...dlg.querySelectorAll<HTMLElement>('[data-group]')];
    const none = dlg.querySelector<HTMLElement>('[data-models-none]')!;
    const body = dlg.querySelector<HTMLElement>('[data-models-body]')!;

    document.querySelector('[data-models-open]')!.addEventListener('click', () => {
      dlg.showModal();
      // On phones, focusing the search box would raise the keyboard over the list.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) search.focus();
      else dlg.querySelector<HTMLElement>('[data-models-close]')!.blur();
    });
    // Escape closes the popup straight away instead of first clearing the search box.
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); dlg.close(); }
    });
    dlg.querySelector('[data-models-close]')!.addEventListener('click', () => dlg.close());
    // Click on the backdrop (outside the dialog box) closes it.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { search.value = ''; filter(); });

    function filter() {
      const q = search!.value.trim().toLowerCase();
      items.forEach((li) => { li.hidden = !!q && !li.dataset.name!.includes(q); });
      groups.forEach((g) => { g.hidden = !g.querySelector('li:not([hidden])'); });
      none.hidden = groups.some((g) => !g.hidden);
      body.scrollTop = 0;
    }
    search.addEventListener('input', filter);
  }
</script>
