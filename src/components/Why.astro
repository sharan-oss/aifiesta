---
import { why } from '../data/content';
import Cta from './Cta.astro';
---
<section class="section">
  <div class="wrap">
    <h2 class="title"><span class="semi">Why </span><span class="grad">AI Fiesta</span><i class="under"></i></h2>
    <p class="sub">Good question. Here's the honest answer.</p>
    <div class="bar"></div>
    <ul>
      {why.map(([h, p]) => (
        <li>
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.75" fill="#00BA00" /><path d="M6.2 10.2l2.7 2.7 5-5.2" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <div><h3>{h}</h3><p>{p}</p></div>
        </li>
      ))}
    </ul>
    <Cta />
  </div>
</section>
<style>
  .semi { font-weight: 600; }
  .sub { margin-top: 16px; }
  ul { display: grid; gap: 20px; margin-block: 32px; }
  li { display: flex; gap: 12px; background: #fff; border-radius: 18px; padding: 22px 18px; }
  li svg { width: 20px; height: 20px; flex: none; margin-top: 2px; }
  li div { display: grid; gap: 10px; }
  h3 { font-size: 16px; font-weight: 700; font-family: var(--font-head); }
  p { font-size: 15px; color: rgba(3,0,37,.75); }
  @media (min-width: 800px) { ul { grid-template-columns: repeat(2, 1fr); } li:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  @media (min-width: 1100px) { ul { grid-template-columns: repeat(3, 1fr); } li:last-child:nth-child(odd) { grid-column: auto; } }
</style>
