---
import { modelGroups } from '../data/models-list';
---
<section class="models" id="all-models">
  <div class="wrap">
    <h2>All AI models included</h2>
    <p class="sub">Every model below comes with your AI Fiesta plan.</p>
    <div class="groups">
      {modelGroups.map((g) => (
        <details open={g.title !== 'Chat models'}>
          <summary>{g.title}</summary>
          <ol>
            {g.models.map((m) => <li>{m}</li>)}
          </ol>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .models { padding-block: var(--section-y, 48px); }
  h2 { font-size: 24px; font-weight: 700; text-align: center; }
  .sub { text-align: center; font-size: 14px; color: var(--muted); margin-top: 6px; }
  .groups { max-width: 900px; margin: 24px auto 0; display: grid; gap: 12px; }
  details { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 4px 18px; }
  summary { cursor: pointer; font-weight: 600; font-size: 16px; padding: 14px 0; display: flex; justify-content: space-between; align-items: center; }
  ol { list-style: none; margin: 0; padding: 0 0 14px; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  ol li { display: flex; gap: 8px; font-size: 14px; font-weight: 500; background: var(--brand-soft, #f6f3ff); border-radius: 10px; padding: 8px 12px; }
</style>
