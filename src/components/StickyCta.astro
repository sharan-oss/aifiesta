---
import { plan, checkoutHrefFor, SALE } from '../data/content';
const checkout = checkoutHrefFor(Astro.url.pathname);
---
<aside class="sticky away" id="sticky-cta" aria-label="Pricing offer" inert>
  <div class="price">
    <p class="amt"><b>{plan.price}</b><span>{plan.per}</span> <s>{plan.was}</s></p>
    <p class="offer"><i class="dot" aria-hidden="true"></i>{SALE.name}</p>
  </div>
  <a class="btn btn--pill" href={checkout} data-cta="sticky"><span>Get AI Fiesta</span> <b>for ₹7,999/year</b></a>
</aside>
<style>
  /* Keep the end of the page clear of the bar. */
  :global(body) { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }

  .sticky {
    position: fixed; z-index: 20; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom));
    max-width: 640px; margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 12px 12px 12px 18px;
    box-shadow: 0 18px 40px -12px rgba(36,32,61,.35);
    transition: transform .3s ease, opacity .3s ease;
  }
  .sticky.away { transform: translateY(calc(100% + 32px)); opacity: 0; }
  .amt { display: flex; align-items: baseline; gap: 2px; white-space: nowrap; }
  .amt b { font-size: 24px; font-weight: 700; color: var(--brand); letter-spacing: -0.02em; }
  .amt span { font-size: 13px; font-weight: 600; }
  .amt s { margin-left: 6px; font-size: 13px; font-weight: 500; color: var(--muted); }
  /* Urgency badge: a pulsing "live" dot plus a shine every few seconds. */
  .offer { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; padding: 3px 9px 3px 8px; border-radius: 99px; background: #0b0a14; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; }
  .dot { position: relative; flex: none; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: currentColor; animation: ping 1.6s cubic-bezier(0,0,.2,1) infinite; }
  .offer::after { content: ''; position: absolute; inset: 0 auto 0 0; width: 45%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent); transform: translateX(-120%) skewX(-18deg); animation: shine 3.2s cubic-bezier(.25,1,.5,1) 1s infinite; }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }
  @keyframes shine { 0% { transform: translateX(-120%) skewX(-18deg); } 35%, 100% { transform: translateX(260%) skewX(-18deg); } }
  .btn { flex: none; height: 52px; padding-inline: 16px; font-size: 13px; line-height: 1.2; flex-direction: column; justify-content: center; gap: 1px; text-align: center; }
  .btn b { font-size: 14px; font-weight: 700; white-space: nowrap; }

  @media (min-width: 768px) {
    :global(body) { padding-bottom: 112px; }
    .sticky { bottom: 20px; border-radius: 999px; padding: 10px 10px 10px 28px; }
    .amt b { font-size: 28px; }
    .amt span, .amt s { font-size: 14px; }
    .offer { font-size: 12px; padding: 4px 11px 4px 10px; }
    .btn { height: 52px; padding-inline: 32px; font-size: 15px; flex-direction: row; gap: .3em; }
    .btn b { font-size: inherit; }
  }
  @media (prefers-reduced-motion: reduce) { .sticky { transition: none; } .dot::after, .offer::after { animation: none; } }
</style>
<script>
  import '../scripts/sticky-cta';
</script>
