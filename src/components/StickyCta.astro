---
import { plan, offer, checkoutHrefFor, SALE } from '../data/content';
const checkout = checkoutHrefFor(Astro.url.pathname);
---
<aside class="sticky away" id="sticky-cta" aria-label="Pricing offer" inert>
  <p class="strip"><i class="dot" aria-hidden="true"></i><b>{SALE.name}</b><span>· Save 33% · {offer.multiple} usage</span></p>
  <div class="row">
    <div class="price">
      <p class="amt"><b>{plan.price}</b><span>{plan.per}</span></p>
      <p class="was"><s>{plan.was}</s></p>
    </div>
    <a class="go" href={checkout} data-cta="sticky">
      <span>Get AI Fiesta<b> for ₹7,999/year</b></span>
      <i aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></i>
    </a>
  </div>
</aside>
<style>
  /* Keep the end of the page clear of the bar. */
  :global(body) { padding-bottom: calc(118px + env(safe-area-inset-bottom)); }

  .sticky {
    position: fixed; z-index: 20; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom));
    max-width: 640px; margin-inline: auto; overflow: hidden;
    background: #fff; border: 1px solid var(--line); border-radius: 20px;
    box-shadow: 0 18px 40px -12px rgba(36,32,61,.35);
    transition: transform .35s cubic-bezier(.32,.72,0,1), opacity .35s ease;
  }
  .sticky.away { transform: translateY(calc(100% + 32px)); opacity: 0; }

  /* Black Friday strip across the top of the bar. */
  .strip {
    position: relative; display: flex; align-items: center; justify-content: center; gap: 6px; height: 26px;
    background: #0a0a0a; color: #fff; font: 800 11px/1 'Manrope', 'Inter', sans-serif; letter-spacing: .07em; text-transform: uppercase; white-space: nowrap;
  }
  .strip b { color: #ffe234; font-weight: 800; }
  .strip span { color: rgba(255,255,255,.85); }
  .dot { position: relative; flex: none; width: 6px; height: 6px; border-radius: 50%; background: #ffe234; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; animation: ping 1.6s cubic-bezier(0,0,.2,1) infinite; }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }

  .row { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 16px; }
  /* Price: compact stack, so the button gets the width. */
  .price { flex: none; display: grid; gap: 2px; }
  .amt { display: flex; align-items: baseline; gap: 2px; white-space: nowrap; font-family: 'Manrope', 'Inter', sans-serif; }
  .amt b { font-size: 22px; font-weight: 800; color: #100e24; letter-spacing: -0.02em; line-height: 1; }
  .amt span { font-size: 13px; font-weight: 700; color: #100e24; }
  .was { font-size: 12.5px; font-weight: 600; color: #9b97ad; line-height: 1; }
  /* Button: same as the hero's (gradient pill, arrow in its own disc), fills the rest of the row. */
  .go {
    flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px;
    height: 52px; padding: 0 6px 0 18px; border-radius: 99px; text-decoration: none;
    background: linear-gradient(100deg, #7c4dff, #3d6bff 60%, #22b8ff); color: #fff;
    font: 800 16px/1.1 'Manrope', 'Inter', sans-serif; letter-spacing: -0.01em; white-space: nowrap;
    box-shadow: 0 12px 24px -12px rgba(61, 107, 255, .8), inset 0 1px 0 rgba(255, 255, 255, .28);
    transition: transform .3s cubic-bezier(.32,.72,0,1);
  }
  .go > span { flex: 1; text-align: center; }
  .go b { display: none; font-weight: 800; }
  .go i { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255, 255, 255, .2); transition: transform .3s cubic-bezier(.32,.72,0,1); }
  .go svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .go:hover i { transform: translateX(3px); }
  .go:active { transform: scale(.98); }

  @media (max-width: 359px) { .strip span { display: none; } }
  @media (min-width: 768px) {
    :global(body) { padding-bottom: 128px; }
    .sticky { bottom: 20px; border-radius: 22px; }
    .strip { height: 28px; font-size: 11.5px; }
    .row { gap: 24px; padding: 12px 12px 12px 24px; }
    .price { display: flex; align-items: baseline; gap: 10px; }
    .amt b { font-size: 28px; }
    .amt span { font-size: 14px; }
    .was { font-size: 14px; }
    .go { height: 56px; padding-left: 26px; font-size: 17px; }
    .go b { display: inline; }
    .go i { width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .sticky { transition: none; } .dot::after { animation: none; } }
</style>
<script>
  import '../scripts/sticky-cta';
</script>
