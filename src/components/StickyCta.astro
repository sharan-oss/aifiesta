---
import { plan, CTA, CTA_HREF } from '../data/content';
---
<aside class="sticky" aria-label="Pricing offer">
  <div class="price">
    <p class="amt"><b>{plan.price}</b><span>{plan.per}</span> <s>{plan.was}</s></p>
    <p class="offer">{plan.offer}</p>
  </div>
  <a class="btn btn--pill" href={CTA_HREF}>{CTA}</a>
</aside>
<style>
  /* Keep the end of the page clear of the bar. */
  :global(body) { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }

  .sticky {
    position: fixed; z-index: 20; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom));
    max-width: 640px; margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 12px 12px 12px 18px;
    box-shadow: 0 18px 40px -12px rgba(36,32,61,.35);
  }
  .amt { display: flex; align-items: baseline; gap: 2px; white-space: nowrap; }
  .amt b { font-size: 24px; font-weight: 700; color: var(--brand); letter-spacing: -0.02em; }
  .amt span { font-size: 13px; font-weight: 600; }
  .amt s { margin-left: 6px; font-size: 13px; font-weight: 500; color: var(--muted); }
  .offer { font-size: 12px; font-weight: 500; color: var(--muted); }
  .btn { flex: none; height: 48px; padding-inline: 22px; font-size: 14px; }

  @media (min-width: 768px) {
    :global(body) { padding-bottom: 112px; }
    .sticky { bottom: 20px; border-radius: 999px; padding: 10px 10px 10px 28px; }
    .amt b { font-size: 28px; }
    .amt span, .amt s { font-size: 14px; }
    .offer { font-size: 13px; }
    .btn { height: 52px; padding-inline: 32px; font-size: 15px; }
  }
</style>
