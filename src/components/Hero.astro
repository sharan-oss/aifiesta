---
// Hero, "Arch": energetic but clean. Words and offer on one side; on the other, Dhruv (clean
// cut-out from his official photos) standing in a tall gradient arch, head breaking out of the
// top, with the models you get floating around him and one AI Fiesta badge at the base.
import { CTA, checkoutHrefFor, offer, plan, SALE } from '../data/content';
const checkout = checkoutHrefFor(Astro.url.pathname);
const chips = [
  ['ChatGPT', '/logos/calc-openai.svg', 'c1'],
  ['Claude', '/logos/calc-claude.svg', 'c2'],
  ['Gemini', '/logos/calc-gemini.svg', 'c3'],
  ['Perplexity', '/logos/calc-perplexity.svg', 'c4'],
];
---
<!-- data-sticky-hide: the sticky bar stays away while the hero (it has its own button) fills the screen. -->
<section class="hero" data-sticky-hide>
  <div class="hero__in">
    <div class="copy">
      <h1>Get <span>100+ premium AI&nbsp;models</span> like ChatGPT, Claude and Gemini in&nbsp;one&nbsp;subscription</h1>
      <p class="lead">Chat, create images, videos, websites and PPTs. {plan.price}/year, less than 4&nbsp;months of ChatGPT.</p>
    </div>

    <div class="visual">
      <div class="arch" aria-hidden="true"><i class="rings"></i></div>
      <img class="dhruv" src="/images/dhruv-hero.webp" alt="Dhruv Rathee, founder of AI Fiesta" width="722" height="960" fetchpriority="high" />
      {chips.map(([name, src, pos]) => (
        <span class={`chip ${pos}`} aria-hidden="true"><img src={src} alt="" width="20" height="20" />{name}</span>
      ))}
      <span class="chip c5" aria-hidden="true"><b>+100</b> more</span>
      <p class="badge" aria-hidden="true"><img src="/images/logo-mark.webp" alt="" width="30" height="30" /><span><b>AI Fiesta</b><small>One subscription</small></span></p>
    </div>

    <div class="act">
      <a class="cta" href={checkout} data-cta="hero">
        <span>{CTA}</span>
        <i class="cta__ic" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></i>
      </a>
      <div class="offer">
        <p class="offer__tag"><i class="dot" aria-hidden="true"></i>{SALE.name}</p>
        <p class="offer__price"><b>{plan.price}</b><span>/year</span> <s>{plan.was}</s> <em>Save 33%</em></p>
        <ul class="offer__list">
          <li class="x4">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
            <p><b>{offer.multiple}</b> usage in your 1st month</p>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
            <p>Free custom domain for a year</p>
          </li>
        </ul>
      </div>
      <p class="rate"><span aria-hidden="true">★★★★★</span> Trusted worldwide by 1M+ users</p>
    </div>
  </div>
</section>
<style>
  .hero {
    --v1: #7c4dff; --v2: #3d6bff; --v3: #22b8ff; --warm: #ff9a62;
    --grad: linear-gradient(100deg, var(--v1), var(--v2) 60%, var(--v3));
    --ink-hi: #100e24;
    --head: 'Manrope', 'Inter', system-ui, sans-serif;
    --ease: cubic-bezier(.32, .72, 0, 1);
    position: relative; isolation: isolate; overflow: hidden;
    background:
      radial-gradient(40% 50% at 78% 40%, rgba(124, 77, 255, .12), transparent 70%),
      radial-gradient(30% 40% at 90% 80%, rgba(255, 154, 98, .12), transparent 70%),
      linear-gradient(#f7f6ff, #fff 90%);
  }
  .hero__in {
    max-width: 1180px; margin-inline: auto; padding: 22px 18px 36px; text-align: center;
    display: grid; grid-template-areas: 'copy' 'visual' 'act';
  }
  .copy { grid-area: copy; }
  .visual { grid-area: visual; }
  .act { grid-area: act; }

  .dot { position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--warm); }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; animation: ping 1.8s var(--ease) infinite; }
  @keyframes ping { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(2.6); opacity: 0; } }

  h1 {
    margin: 16px auto 0; font-family: var(--head); font-weight: 800; color: var(--ink-hi);
    font-size: clamp(23px, 6.6vw, 40px); line-height: 1.16; letter-spacing: -0.03em; text-wrap: balance;
  }
  h1 span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .06em; }
  .lead { margin: 12px auto 0; max-width: 540px; font-size: 15px; line-height: 1.5; color: #5b5873; text-wrap: pretty; }

  /* The visual: arch + Dhruv + floating chips. Sized as one unit (--A = arch width). */
  .visual { --A: min(64vw, 270px); position: relative; width: var(--A); margin: 44px auto 0; aspect-ratio: 1 / 1.08; }
  .arch {
    position: absolute; inset: 14% 0 0; border-radius: 999px 999px 28px 28px; overflow: hidden;
    background: linear-gradient(160deg, #9a6bff 0%, var(--v2) 55%, #2a9dff 100%);
    box-shadow: 0 40px 60px -34px rgba(61, 107, 255, .8), inset 0 1px 0 rgba(255, 255, 255, .35);
  }
  /* Soft rings radiating from behind his head, and a warm light from the bottom right. */
  .rings {
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 50% 18%, transparent 0 22%, rgba(255, 255, 255, .14) 22.4% 22.8%, transparent 23.2% 34%, rgba(255, 255, 255, .1) 34.4% 34.8%, transparent 35.2% 47%, rgba(255, 255, 255, .07) 47.4% 47.8%, transparent 48.2%),
      radial-gradient(60% 45% at 90% 100%, rgba(255, 154, 98, .55), transparent 70%);
  }
  .dhruv {
    position: absolute; left: 50%; bottom: 0; translate: -50% 0; width: 92%; height: auto;
    border-radius: 0 0 28px 28px;
    filter: drop-shadow(0 18px 30px rgba(16, 14, 36, .28));
  }

  .chip {
    position: absolute; z-index: 2; width: max-content; display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px 7px 8px; border-radius: 99px;
    background: #fff; white-space: nowrap; font-family: var(--head); font-size: 12.5px; font-weight: 700; color: var(--ink-hi);
    box-shadow: 0 0 0 1px rgba(16, 14, 36, .06), 0 14px 26px -14px rgba(40, 30, 120, .5);
    animation: bob 5s ease-in-out infinite alternate;
  }
  .chip img { width: 18px; height: 18px; }
  .chip b { font-weight: 800; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .c1 { left: -22%; top: 24%; rotate: -4deg; }
  .c2 { right: -24%; top: 16%; rotate: 4deg; animation-delay: -1.2s; }
  .c3 { left: -26%; top: 56%; rotate: 3deg; animation-delay: -2.4s; }
  .c4 { right: -22%; top: 47%; rotate: -3deg; animation-delay: -3.6s; }
  .c5 { right: -12%; top: 75%; rotate: 2deg; animation-delay: -.6s; padding-left: 12px; }
  @keyframes bob { to { translate: 0 -7px; } }

  .badge {
    position: absolute; z-index: 3; left: 50%; bottom: -18px; translate: -50% 0; width: max-content;
    display: inline-flex; align-items: center; gap: 9px; padding: 7px 16px 7px 7px; border-radius: 16px;
    background: #fff; white-space: nowrap; text-align: left;
    box-shadow: 0 0 0 1px rgba(124, 77, 255, .16), 0 18px 34px -16px rgba(40, 30, 120, .6);
  }
  .badge img { width: 30px; height: 30px; }
  .badge span { display: grid; line-height: 1.15; }
  .badge b { font-family: var(--head); font-size: 14px; font-weight: 800; color: var(--ink-hi); }
  .badge small { font-size: 11.5px; font-weight: 600; color: #6c6888; }

  .act { display: grid; gap: 10px; justify-items: center; margin-top: 38px; }
  .cta {
    position: relative; overflow: hidden; display: flex; align-items: center; gap: 12px;
    width: 100%; max-width: 470px; height: 60px; padding: 0 7px 0 26px; border-radius: 99px;
    background: var(--grad); color: #fff; font-family: var(--head); font-size: 16.5px; font-weight: 800; letter-spacing: -0.01em;
    box-shadow: 0 18px 32px -16px rgba(61, 107, 255, .9), inset 0 1px 0 rgba(255, 255, 255, .3);
    transition: transform .45s var(--ease), box-shadow .45s var(--ease);
  }
  .cta > span { flex: 1; }
  .cta__ic { flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: rgba(255, 255, 255, .2); transition: transform .45s var(--ease); }
  .cta__ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cta::after { content: ''; position: absolute; inset: 0 auto 0 0; width: 40%; background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .32), transparent); transform: translateX(-130%) skewX(-18deg); animation: shine 4.5s var(--ease) 1.2s infinite; }
  @keyframes shine { 0% { transform: translateX(-130%) skewX(-18deg); } 40%, 100% { transform: translateX(330%) skewX(-18deg); } }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 24px 38px -16px rgba(61, 107, 255, 1), inset 0 1px 0 rgba(255, 255, 255, .3); }
  .cta:hover .cta__ic { transform: translateX(3px) scale(1.05); }
  .cta:active { transform: scale(.98); }

  /* The offer card: limited-time tag, price with the old price struck out, the two bonuses. */
  .offer {
    position: relative; width: 100%; max-width: 470px; margin-top: 16px; text-align: left;
    background: #fff; border: 1.5px solid var(--brand); border-radius: 18px; padding: 22px 16px 14px;
    box-shadow: 0 18px 34px -26px rgba(81, 70, 217, .7);
  }
  .offer__tag {
    position: absolute; top: -13px; left: 50%; translate: -50% 0; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 7px; padding: 4px 12px 4px 10px; border-radius: 99px;
    background: #0b0a14; color: #fff; font-size: 11.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  }
  /* Black Friday: black tag, the dot in the brand gradient. */
  .offer__tag .dot { background: linear-gradient(135deg, #7c4dff, #22b8ff); }
  .offer__tag .dot { width: 7px; height: 7px; }
  .offer__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; font-family: var(--head); }
  .offer__price b { font-size: 32px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--ink-hi); }
  .offer__price span { margin-left: -8px; font-size: 15px; font-weight: 700; color: var(--ink-hi); }
  .offer__price s { font-size: 15px; font-weight: 600; color: #b1999a; }
  .offer__price em { font-style: normal; font-size: 12px; font-weight: 700; color: #2f7d54; background: #e6f4ea; padding: 4px 10px; border-radius: 99px; }
  .offer__list { display: grid; gap: 9px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  .offer__list li { display: flex; align-items: center; gap: 11px; font-size: 15px; font-weight: 600; color: var(--ink-hi); }
  .offer__list svg { flex: none; width: 20px; height: 20px; fill: none; stroke: var(--brand); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* 4x is the lead bonus: the one green accent. */
  .x4 svg { stroke: #3f9b6a; }
  .x4 b { color: #2f7d54; font-family: var(--head); font-size: 1.3em; font-weight: 800; letter-spacing: -0.02em; }
  .rate { font-size: 13px; font-weight: 500; color: #6c6888; }
  .rate span { color: #ffb01f; letter-spacing: 1px; margin-right: 4px; }

  /* Phones: the button must be on the first screen, even inside the Instagram/Facebook in-app
     browser (its bars eat 100-180px). Everything is tightened, and Dhruv's arch is sized from the
     real screen height (svh = with the browser bars showing): the rest of the stack down to the button
     is ~300px. */
  @media (max-width: 959px) {
    .hero__in { padding: 16px 16px 28px; }
    h1 { margin-top: 6px; }
    .lead { margin-top: 8px; font-size: 14.5px; line-height: 1.45; }
    .visual { --A: min(62vw, 250px, max(150px, calc((100svh - 300px) / 1.08))); margin-top: 30px; }
    .act { margin-top: 32px; gap: 8px; }
    .offer { margin-top: 14px; padding: 18px 14px 10px; border-radius: 16px; }
    .offer__tag { top: -12px; font-size: 11px; padding: 3px 11px 3px 9px; }
    .offer__price b { font-size: 28px; }
    .offer__price span, .offer__price s { font-size: 14px; }
    .offer__price em { font-size: 11.5px; padding: 3px 9px; }
    .offer__list { gap: 6px; margin-top: 9px; padding-top: 9px; }
    .offer__list li { font-size: 14px; gap: 10px; }
    .offer__list svg { width: 18px; height: 18px; }
    .cta { height: 56px; font-size: 16px; }
    .cta__ic { width: 42px; height: 42px; }
  }

  /* Desktop: words + offer on the left, the arch on the right. */
  @media (min-width: 960px) {
    .hero__in {
      text-align: left; padding: 64px 40px 80px;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
      grid-template-areas: 'copy visual' 'act visual';
      grid-template-rows: auto 1fr; column-gap: 56px;
    }
    h1 { margin: 22px 0 0; font-size: clamp(40px, 3.4vw, 50px); line-height: 1.08; letter-spacing: -0.035em; }
    .lead { margin: 18px 0 0; font-size: 19px; max-width: 560px; }
    .act { justify-items: start; align-content: start; margin-top: 30px; gap: 14px; }
    .cta { height: 64px; font-size: 18px; }
    .offer { padding: 26px 22px 18px; border-radius: 20px; }
    .offer__price b { font-size: 40px; }
    .offer__price span, .offer__price s { font-size: 16px; }
    .offer__list li { font-size: 16.5px; }
    .visual { --A: min(340px, 30vw); align-self: center; margin: 0 auto; }
    .chip { font-size: 14px; padding: 9px 15px 9px 10px; gap: 8px; }
    .chip img { width: 20px; height: 20px; }
    .badge b { font-size: 15px; }
  }

  /* Tablets: same stack as phones, with more side room. */
  @media (min-width: 640px) and (max-width: 959px) {
    .hero__in { padding-inline: 48px; }
    .lead { font-size: 16px; }
  }
  /* Small laptops: the photo column is narrow, so the chips hug the arch instead of the screen edge. */
  @media (min-width: 960px) and (max-width: 1279px) {
    .visual { --A: min(300px, 27vw); }
    .c1 { left: -16%; } .c3 { left: -20%; }
    .c2 { right: -14%; } .c4 { right: -16%; } .c5 { right: -6%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip, .dot::after, .cta::after { animation: none; }
  }
</style>
