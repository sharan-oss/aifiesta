---
// Hero built around the offer. One path for the eye: the equation -> the deal -> the button.
// Headline is an equation (ChatGPT + Claude + Gemini + Perplexity + 100+ = one AI Fiesta subscription).
// The lead and the 4x line mirror the best-performing ads (cheaper than ChatGPT alone, "4X bonus usage").
import { CTA, checkoutHrefFor, offer, plan } from '../data/content';
const checkout = checkoutHrefFor(Astro.url.pathname);
const eq = [
  ['ChatGPT', '/logos/calc-openai.svg'],
  ['Claude', '/logos/calc-claude.svg'],
  ['Gemini', '/logos/calc-gemini.svg'],
  ['Perplexity', '/logos/calc-perplexity.svg'],
];
---
<section class="hero wrap">
  <div class="hero__copy">
    <h1>
      <span class="eq">
        {eq.map(([name, src]) => <><span class="ai"><img src={src} alt={name} width="26" height="26" /></span><i aria-hidden="true">+</i></>)}
        <span class="ai ai--more">100+<span class="sr-only"> more AI models</span></span>
      </span>
      <span class="equals">=<span class="sr-only"> equals </span></span>
      <span class="one">One <span class="brand"><img src="/images/logo-mark.webp" alt="" width="34" height="34" />AI Fiesta</span> subscription</span>
    </h1>
    <p class="lead">Chat, create images, videos, websites and PPTs. ₹7,999/year, less than 4 months of ChatGPT.</p>
  </div>

  <div class="hero__media"><img src="/images/hero-dhruv.webp" alt="Dhruv Rathee holding a phone surrounded by AI app icons" width="796" height="718" fetchpriority="high" /></div>

  <!-- data-sticky-hide: the sticky bar stays away while this block is on screen. -->
  <div class="hero__act" data-sticky-hide>
    <div class="deal">
      <p class="deal__tag"><i class="dot" aria-hidden="true"></i>Limited-time offer</p>
      <p class="deal__price"><b>{plan.price}</b><span>/year</span> <s>{plan.was}</s> <em>Save 33%</em></p>
      <ul class="deal__list">
        <li class="x4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
          <p><b>{offer.multiple}</b> usage in your 1st month</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
          <p>Free custom domain for a year</p>
        </li>
      </ul>
    </div>
    <a class="btn btn--block hero__cta" href={checkout} data-cta="hero">{CTA}</a>
    <p class="hero__note">Billed once a year · Cancel anytime</p>
  </div>
</section>
<style>
  .hero { display: grid; gap: 18px; padding-block: 22px var(--section-y); text-align: center; }
  /* The headline is an equation: logo row, "=", then the one subscription. */
  h1 { display: grid; justify-items: center; margin-block: 4px 12px; font-weight: 700; letter-spacing: -0.025em; }
  .eq { display: flex; align-items: center; gap: clamp(4px, 1.6vw, 8px); }
  .eq i { font-style: normal; font-size: 18px; font-weight: 700; color: var(--muted); }
  .ai { flex: none; display: grid; place-items: center; width: clamp(42px, 11.8vw, 48px); aspect-ratio: 1; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1.5px var(--line), 0 8px 16px -10px rgba(36,32,61,.45); }
  .ai img { width: 56%; height: 56%; }
  .ai--more { background: var(--brand); color: #fff; box-shadow: 0 8px 16px -8px rgba(81,70,217,.8); font-size: 15px; letter-spacing: 0; }
  .equals { font-size: 24px; line-height: 1; color: var(--muted); margin-block: 6px 2px; }
  .one { font-size: clamp(30px, 8.4vw, 38px); line-height: 1.2; text-wrap: balance; }
  .brand { display: inline-flex; align-items: center; gap: .18em; white-space: nowrap; color: var(--brand); vertical-align: -0.12em; padding: .02em .28em .02em .12em; border-radius: 99px; background: #fff; box-shadow: 0 0 0 1.5px var(--line); }
  .brand img { width: .95em; height: .95em; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Full width; 'pretty' only stops a one-word last line (balance made the block look narrow). */
  .lead { font-size: 15px; font-weight: 500; color: var(--muted); max-width: 520px; margin-inline: auto; text-wrap: pretty; }

  /* The deal: compact, so the photo above it and the button below it carry the weight. */
  .hero__act { display: grid; gap: 12px; }
  .deal { position: relative; text-align: left; background: #fff; border: 1.5px solid var(--brand); border-radius: 16px; padding: 20px 14px 12px; box-shadow: 0 16px 32px -26px rgba(81,70,217,.6); }
  .deal__tag { position: absolute; top: -12px; left: 50%; translate: -50% 0; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 9px; border-radius: 99px; background: #d9381e; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .dot { position: relative; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: currentColor; animation: ping 1.6s cubic-bezier(0,0,.2,1) infinite; }
  .deal__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 9px; }
  .deal__price b { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .deal__price span { font-size: 14px; font-weight: 600; margin-left: -7px; }
  .deal__price s { font-size: 14px; font-weight: 500; color: #b1999a; }
  .deal__price em { font-style: normal; font-size: 11px; font-weight: 700; color: #2f7d54; background: #e6f4ea; padding: 3px 8px; border-radius: 99px; }
  .deal__list { display: grid; gap: 7px; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
  .deal__list li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; }
  .deal__list svg { flex: none; width: 18px; height: 18px; color: var(--brand); }
  /* 4x is the lead bonus: the one green accent on the screen. */
  .x4 svg { color: #3f9b6a; }
  .x4 b { color: #2f7d54; font-size: 1.25em; font-weight: 700; letter-spacing: -0.02em; }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }

  .hero__cta { height: 56px; font-size: 16px; font-weight: 700; border-radius: 14px; box-shadow: 0 14px 26px -14px rgba(81,70,217,.9); }
  .hero__note { font-size: 13px; font-weight: 500; color: var(--muted); }

  .hero__media { background: var(--brand-tint); border-radius: 24px; overflow: hidden; }
  .hero__media img { width: 100%; height: auto; }
  /* Phones: the photo fills the width and is cropped at the chest, so Dhruv reads large. */
  @media (max-width: 899px) {
    .hero__media img { height: 224px; object-fit: cover; object-position: center 8%; }
  }
  /* Short phones: a shorter photo keeps the offer card and button on the first screen. */
  @media (max-width: 899px) and (max-height: 780px) { .hero__media img { height: 156px; } }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1fr 1fr; column-gap: 64px; row-gap: 28px; align-items: center; text-align: left; padding-block: 64px var(--section-y); }
    .lead { margin-inline: 0; font-size: 18px; }
    h1 { justify-items: start; margin-block: 0 14px; }
    .ai { width: 60px; }
    .ai--more { font-size: 17px; }
    .eq { gap: 10px; }
    .one { font-size: clamp(40px, 3.6vw, 50px); }
    .hero__copy { grid-column: 1; grid-row: 1; align-self: end; }
    .hero__act { grid-column: 1; grid-row: 2; align-self: start; max-width: 440px; }
    .hero__note { text-align: center; }
    .hero__media { grid-column: 2; grid-row: 1 / span 2; box-shadow: 0 18px 40px -24px rgba(36,32,61,.35); }
    .deal { padding: 26px 18px 18px; border-radius: 20px; }
    .deal__price { gap: 4px 10px; }
    .deal__price b { font-size: 40px; }
    .deal__price span, .deal__price s { font-size: 15px; }
    .deal__price em { font-size: 12px; }
    .deal__list { gap: 12px; margin-top: 16px; padding-top: 16px; }
    .deal__list li { font-size: 15px; gap: 12px; }
    .deal__list svg { width: 20px; height: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; } }
</style>
