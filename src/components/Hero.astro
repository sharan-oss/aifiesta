---
import { CTA, checkoutHrefFor } from '../data/content';
import YcBadge from './YcBadge.astro';
const checkout = checkoutHrefFor(Astro.url.pathname);
---
<section class="hero wrap">
  <div class="hero__copy">
    <YcBadge />
    <div class="hero__rate">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <p>Trusted worldwide by 1M+ users</p>
    </div>
    <h1>One Subscription for <span class="hl">100+</span> AI Models 🚀</h1>
    <p class="lead">One stop solution to all your AI needs: chat, compare answers, generate images and videos, build websites and create presentations — all from one dashboard.</p>
  </div>
  <div class="hero__media"><img src="/images/hero-dhruv.webp" alt="Dhruv Rathee holding a phone surrounded by AI app icons" width="796" height="718" fetchpriority="high" /></div>
  <div class="hero__act">
    <a class="btn btn--block hero__cta" href={checkout} data-cta="hero">
      {CTA}
      <img class="dots" src="/logos/cta-dots.webp" alt="" width="108" height="30" />
    </a>
    <p class="hero__offer"><s>₹11,988</s> save 33% - <em>Hurry Up! Limited Time Offer</em></p>
  </div>
</section>
<style>
  .hero { display: grid; gap: 24px; padding-block: 24px var(--section-y); text-align: center; }
  .hero__copy :global(.yc) { margin-bottom: 14px; }
  .hero__rate { display: grid; gap: 5px; }
  .stars { color: var(--gold); font-size: 17px; }
  .hero__rate p { font-size: 12px; font-weight: 500; color: var(--muted); }
  h1 { font-size: clamp(35px, 8vw, 60px); line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; margin-block: 16px; }
  .hl { color: var(--blue); text-decoration: underline; text-decoration-color: var(--ink); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .lead { font-size: 16px; font-weight: 500; color: var(--muted); max-width: 520px; margin-inline: auto; }
  .hero__media { background: var(--brand-tint); border-radius: 24px; overflow: hidden; box-shadow: 0 18px 40px -24px rgba(36,32,61,.35); }
  .hero__media img { width: 100%; height: auto; }
  .dots { height: 30px; width: auto; flex: none; }
  @media (max-width: 479px) { .dots { display: none; } }
  .hero__act { display: grid; gap: 10px; }
  .hero__offer { text-align: center; font-size: 14px; font-weight: 500; color: var(--muted); }
  .hero__offer s { color: #b1999a; }
  .hero__offer em { color: var(--danger); font-style: normal; }
  /* Phones: tighter stack so the CTA stays above the sticky bar. */
  @media (max-width: 899px) {
    .hero { gap: 16px; padding-top: 12px; }
    .hero__act { gap: 8px; }
    .hero__copy :global(.yc) { margin-bottom: 10px; }
    .hero__rate { display: flex; justify-content: center; align-items: center; gap: 8px; }
    .stars { font-size: 15px; }
    h1 { margin-block: 10px; }
    .hero__media img { max-height: 260px; object-fit: contain; object-position: center bottom; }
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1fr 1fr; align-items: center; text-align: left; padding-block: 72px var(--section-y); gap: 56px; }
    .lead { margin-inline: 0; }
    .hero__copy { grid-column: 1; grid-row: 1; }
    .hero__media { grid-column: 2; grid-row: 1 / span 2; }
    .hero__act { grid-column: 1; grid-row: 2; max-width: 360px; align-self: start; }
  }
</style>
