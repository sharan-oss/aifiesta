---
// Forward the landing URL's query string (UTMs, ad ids, fbclid) to the checkout
// link, so checkout records which ad each payment came from. Existing params on the link win.
import { CHECKOUT_PREFIX } from '../data/content';
---
<script is:inline define:vars={{ checkoutHref: CHECKOUT_PREFIX }}>
  if (location.search) document.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(location.search);
    document.querySelectorAll('a[href^="' + checkoutHref + '"]').forEach(function (a) {
      var url = new URL(a.href);
      params.forEach(function (value, key) { if (!url.searchParams.has(key)) url.searchParams.set(key, value); });
      a.href = url.toString();
    });
  });
</script>
