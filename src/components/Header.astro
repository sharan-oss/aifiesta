---
import { CTA, CTA_HREF } from '../data/content';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" aria-label="AI Fiesta"><img src="/images/logo.png" alt="AI Fiesta" width="147" height="32" /></a>
    <a class="btn btn--pill hdr__cta" href={CTA_HREF}>{CTA}</a>
  </div>
</header>
<style>
  .hdr { border-bottom: 1px solid rgba(11,18,32,.08); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; padding-block: 14px; }
  .hdr img { height: 32px; width: auto; }
  .hdr__cta { height: 44px; padding-inline: 20px; box-shadow: 0 10px 24px -12px rgba(11,18,32,.55); }
</style>
