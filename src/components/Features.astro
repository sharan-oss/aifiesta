---
import { features, CTA, PRICING_HREF } from '../data/content';
---
<section class="wrap feat">
  <h2 class="section-title">Create faster without paying for <span class="accent">5 different AI tools</span></h2>
  <div class="stack">
    {features.map((f, i) => (
      <article class:list={['card', { alt: i % 2 === 1 }]} style={`--i:${i}`} data-stack>
        <div class="copy">
          <div class="top"><span class="num">{f.n}</span>{f.isNew && <span class="badge">NEW</span>}</div>
          <h3>{f.title.join(' ')}</h3>
          <p>{f.body}</p>
        </div>
        <div class="media">
          <img src={`/images/${f.img}`} alt={f.alt} loading="lazy" />
          {f.video && <video data-src={`/videos/${f.video}`} muted loop playsinline preload="none" aria-hidden="true"></video>}
        </div>
      </article>
    ))}
  </div>
  <a class="btn btn--block cta" href={PRICING_HREF} data-cta="features">{CTA}</a>
</section>
<style>
  .feat { padding-block: 16px var(--section-y); display: grid; gap: 28px; --stack-top: 16px; }
  .stack { display: flex; flex-direction: column; gap: 24px; }
  .card {
    position: sticky; top: calc(var(--stack-top) + var(--i) * 10px);
    display: flex; flex-direction: column; gap: 16px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 20px 18px;
    box-shadow: 0 -20px 50px -30px rgba(36,32,61,.35);
    transform-origin: 50% 0%; will-change: transform;
  }
  .card.alt { background: var(--brand-soft); }
  .copy { display: grid; gap: 8px; }
  .top { display: flex; justify-content: space-between; align-items: center; min-height: 25px; }
  .num { font-size: 14px; font-weight: 500; color: var(--brand); }
  .badge { background: var(--brand); color: #fff; font-size: 14px; font-weight: 500; padding: 4px 10px; border-radius: 999px; }
  h3 { text-wrap: balance; font-size: 28px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; }
  .card p { font-size: 15px; font-weight: 500; color: var(--muted); }
  .media { position: relative; aspect-ratio: 16/9; border-radius: 18px; overflow: hidden; background: #05080f; }
  .media img, .media video { width: 100%; height: 100%; object-fit: cover; }
  .media video { position: absolute; inset: 0; opacity: 0; transition: opacity .4s ease; }
  .media video.on { opacity: 1; }
  .cta { max-width: 640px; justify-self: center; }

  @media (min-width: 768px) {
    .feat { --stack-top: 40px; }
    .stack { gap: 40px; }
    .card { display: grid; grid-template-columns: 1fr 1.2fr; align-items: center; column-gap: 48px; padding: 40px; border-radius: 28px; }
    .copy { gap: 12px; }
    h3 { font-size: 40px; }
    .card p { font-size: 17px; max-width: 42ch; }
  }
</style>
<script>
  import '../scripts/feature-videos';

  // Shrink each pinned card a little as the next one slides over it.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-stack]')];
  if (cards.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const update = () => {
      queued = false;
      const vh = innerHeight;
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) return;
        const p = Math.min(1, Math.max(0, (vh - next.getBoundingClientRect().top) / (vh * 0.75)));
        card.style.transform = `scale(${1 - 0.06 * p})`;
      });
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>
