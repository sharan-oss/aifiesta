---
import Icon from './Icon.astro';
import { CHECKOUT_HREF, CTA_TEXT, india, planRows } from '../../data/content-india';
---
<section class="sec price" id="pricing">
  <div class="wrap">
    <h2 class="h2">Everything you get, <br /><em>every month</em></h2>
    <div class="card">
      <p class="name">AI Fiesta Basic</p>
      <p class="amt">₹7,999<small>/yr</small></p>
      <p class="save">(₹11,988, save ₹3,989)</p>
      <p class="per">Just ₹667/month, billed yearly</p>
      <div class="bonus">
        <span class="gi"><Icon name="gift" color="#80dca9" size={22} /></span>
        <p>Get <em>4x</em> of everything</p>
      </div>
      <div class="plan" role="table" aria-label="Usage in your plan">
        <div class="pr ph" role="row">
          <span>In your plan</span>
          <span class="c">Usually</span>
          <span class="c offer">Current Offer*<small>Upto</small></span>
        </div>
        {planRows.map(([label, usual, offer, ic]) => (
          <div class="pr" role="row">
            <span class="l"><Icon name={ic} color="#ffc8a4" size={16} />{label}</span>
            <span class="c u">{usual}</span>
            <span class="c"><b class="pill">{offer}</b></span>
          </div>
        ))}
      </div>
      <p class="roll"><Icon name="refresh" color="#ffc8a4" />All unused tokens roll over to next month. They never expire.</p>
      <a class="btn" href={CHECKOUT_HREF} data-cta="pricing">{CTA_TEXT}</a>
    </div>
  </div>
</section>
<section class="sec sec--dark ind">
  <div class="wrap">
    <img class="hero-art" src="/india/rupee-phone.webp" alt="" width="260" height="260" loading="lazy" />
    <h2 class="h2">INDIA KA AI.<br /><em>PRICED FOR INDIANS.</em></h2>
    <ul class="pts">
      {india.map(([t, ic]) => <li><Icon name={ic} color="#ffc8a4" size={22} /><p>{t}</p></li>)}
    </ul>
  </div>
</section>
<style>
  .hero-art { width: min(260px, 70%); height: auto; margin: 0 auto 12px; }
  .pts { display: grid; gap: 12px; margin: 28px auto 0; max-width: 520px; }
  .pts li { display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 16px; background: var(--dark-2); border: 1px solid var(--dark-line); color: #fff8ef; }
  .pts svg { flex: none; }
  @media (min-width: 768px) { .pts { grid-template-columns: repeat(3, 1fr); max-width: none; } .pts li { flex-direction: column; text-align: center; padding: 28px 20px; } }
  .price { background: linear-gradient(116.03deg, var(--sand) 10.28%, #f7e4ec 88.3%); }
  .card { max-width: 480px; margin: 28px auto 0; display: grid; gap: 14px; padding: 24px 20px; border-radius: 24px; border: 1px solid var(--dark-line); background: linear-gradient(116.03deg, var(--dark) 10.28%, var(--dark-2) 88.3%); box-shadow: 0 8px 22px rgba(51,32,63,.16); color: #fff8ef; }
  .name { text-align: center; font-family: var(--font-head); font-size: 21px; font-weight: 700; }
  .amt { text-align: center; font-family: var(--font-head); font-size: clamp(40px, 10vw, 52px); font-weight: 700; line-height: 1.1; }
  .amt small { font-size: .38em; font-weight: 600; color: var(--soft); margin-left: 4px; }
  .save { justify-self: center; padding: 8px 14px; border-radius: 12px; background: var(--lav-2); color: var(--dark); font-weight: 700; font-size: 13px; }
  .per { text-align: center; color: var(--soft); font-size: 13px; padding-bottom: 6px; border-bottom: 1px solid var(--dark-line); padding-bottom: 14px; }
  .bonus { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 16px; background: rgba(128, 220, 169, .14); border: 1px solid rgba(128, 220, 169, .4); }
  .gi { flex: none; width: 40px; height: 40px; border-radius: 12px; background: rgba(128, 220, 169, .18); display: grid; place-items: center; }
  .bonus p { font-family: var(--font-head); font-size: 20px; font-weight: 700; color: #fff8ef; }
  .bonus em { font-style: normal; font-size: 1.15em; color: #80dca9; }
  .plan { display: grid; }
  .pr { display: grid; grid-template-columns: 1.3fr .8fr 1fr; align-items: center; gap: 8px; padding-block: 12px; border-bottom: 1px solid var(--dark-line); }
  .pr:last-child { border-bottom: 0; }
  .ph { font-size: 12px; font-weight: 700; color: var(--soft); align-items: end; }
  .ph .offer { color: #80dca9; line-height: 1.15; }
  .ph .offer small { display: block; font-size: 10px; font-weight: 500; color: var(--soft); }
  .c { text-align: center; }
  .l { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #fff8ef; }
  .l svg { flex: none; }
  .u { color: var(--soft); font-size: 14px; }
  .pill { display: inline-block; min-width: 64px; padding: 6px 14px; border-radius: 99px; background: rgba(128, 220, 169, .18); color: #bff0d6; font-size: 14px; font-weight: 700; }
  .roll { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 14px; background: var(--dark-2); color: var(--peach); font-size: 12px; }
  .roll svg { flex: none; }
</style>
