---
import { bestModels } from '../../data/content-india';
// Mobile: slider of 2x2 pages (4 models each). Desktop: pages dissolve into one grid.
const pages = Array.from({ length: Math.ceil(bestModels.length / 4) }, (_, i) => bestModels.slice(i * 4, i * 4 + 4));
---
<section class="sec mod">
  <div class="wrap">
    <h2 class="h2">Pick the right AI for <br /><em>every job</em></h2>
    <div class="slider">
      <div class="pages" tabindex="0" aria-label="AI models by use case">
        {pages.map((page) => (
          <ul class="page">
            {page.map(([n, d, logo]) => (
              <li>
                <span class="ic">{logo ? <img src={logo} alt="" width="32" height="32" loading="lazy" /> : <b>{n[0]}</b>}</span>
                <p><b>{n}:</b> {d}</p>
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="dots">
        {pages.map((_, i) => <button type="button" class:list={['dot', { on: i === 0 }]} aria-label={`Go to slide ${i + 1}`}></button>)}
      </div>
    </div>
    <p class="more">+ 100 more models to explore, from DeepSeek to Qwen to Mistral</p>
  </div>
</section>
<style>
  .mod { background: linear-gradient(116.03deg, var(--sand) 10.28%, var(--lav-2) 88.3%); }
  .slider { margin-top: 28px; }
  .pages { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; gap: 12px; margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad); scroll-padding-inline: var(--pad); }
  .pages::-webkit-scrollbar { display: none; }
  .page { flex: 0 0 100%; scroll-snap-align: start; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 0; margin: 0; list-style: none; }
  .dots { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; }
  .dot { width: 6px; height: 6px; padding: 0; border: 0; border-radius: 50%; background: var(--line); cursor: pointer; transition: all .2s; }
  .dot.on { width: 9px; height: 9px; background: var(--plum); }
  li { display: grid; align-content: start; gap: 14px; padding: 16px; border-radius: 20px; border: 1px solid var(--line); background: linear-gradient(116.03deg, var(--cream) 10.28%, var(--sand) 88.3%); box-shadow: 0 3px 12px rgba(33,28,47,.06); }
  .ic { width: 48px; height: 48px; border-radius: 14px; background: var(--cream); border: 1px solid var(--line); display: grid; place-items: center; }
  .ic img { width: 32px; height: 32px; object-fit: contain; }
  .ic b { font-family: var(--font-head); font-size: 20px; color: var(--plum); }
  li p { font-size: 13px; color: var(--muted); }
  li p b { color: var(--ink); }
  .more { margin-top: 24px; text-align: center; font-weight: 500; color: var(--dark); }
  @media (min-width: 640px) {
    .pages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; overflow: visible; margin: 0; padding: 0; }
    .page { display: contents; }
    .dots { display: none; }
    li p { font-size: 14px; }
  }
  @media (min-width: 1000px) { .pages { grid-template-columns: repeat(5, 1fr); } }
</style>
<script>
  const pages = document.querySelector<HTMLElement>('.mod .pages');
  const dots = [...document.querySelectorAll<HTMLElement>('.mod .dot')];
  if (pages && dots.length) {
    const slides = [...pages.querySelectorAll<HTMLElement>('.page')];
    const mark = (i: number) => dots.forEach((d, j) => d.classList.toggle('on', i === j));
    pages.addEventListener('scroll', () => mark(Math.round(pages.scrollLeft / (slides[0].offsetWidth + 12))), { passive: true });
    dots.forEach((d, i) => d.addEventListener('click', () => pages.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: 'smooth' })));
  }
</script>
