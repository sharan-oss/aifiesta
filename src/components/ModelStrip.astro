---
import { models } from '../data/content';
import ModelItem from './ModelItem.astro';

// Logo ticker: two rows of every model, moving in opposite directions, each ending in a
// "+90 more" chip. Each set is repeated so one set is wider than any screen; the track holds
// two copies and slides by half, which makes the loop seamless.
const rowB = [...models.slice(5), ...models.slice(0, 5)];
const rows = [
  { items: models, dur: '46s', dir: 'normal' },
  { items: rowB, dir: 'reverse', dur: '52s' },
];
---
<section class="strip" aria-labelledby="strip-title">
  <img class="strip__logo" src="/images/logo-clear.webp" alt="AI Fiesta" width="150" height="36" loading="lazy" />
  <h2 class="strip__title" id="strip-title">100+ AI models, one subscription</h2>
  <ul class="sr-only">{models.map((m) => <li>{m.name}</li>)}<li>and 90 more</li></ul>

  <div class="ticker" aria-hidden="true">
    {rows.map((r) => (
      <div class="row">
        <div class="track" style={`animation-duration:${r.dur};animation-direction:${r.dir}`}>
          {[0, 1].map(() => (
            <ul class="set">
              {[0, 1].map(() => (
                <>
                  {r.items.map((m) => <li class="chip"><ModelItem name={m.name} icon={m.icon} /></li>)}
                  <li class="chip chip--more">+90 more</li>
                </>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .strip { background: #fff; padding-block: 28px; overflow: hidden; }
  .strip__logo { width: 150px; height: auto; margin: 0 auto 10px; }
  .strip__title { text-align: center; font-size: 15px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--muted); margin: 0 16px 20px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .ticker { display: grid; gap: 12px; }
  .row { overflow: hidden; padding-block: 4px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; animation: scroll linear infinite; will-change: transform; }
  .ticker:hover .track { animation-play-state: paused; }
  .set { display: flex; gap: 12px; padding-right: 12px; }
  .chip { display: flex; align-items: center; height: 48px; padding: 0 18px 0 12px; border-radius: 99px; background: #fff; border: 1px solid var(--line); box-shadow: 0 1px 2px rgba(20,16,50,.04), 0 4px 14px -6px rgba(20,16,50,.08); color: var(--ink); }
  .chip--more { padding-inline: 18px; border-color: transparent; background: linear-gradient(135deg, var(--brand), #8b5cf6); color: #fff; font-size: 14px; font-weight: 700; white-space: nowrap; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (min-width: 640px) {
    .strip { padding-block: 36px; }
    .strip__title { margin-bottom: 24px; }
    .ticker { gap: 16px; }
    .set { gap: 16px; padding-right: 16px; }
    .chip { height: 56px; padding: 0 22px 0 14px; }
    .row { -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .row { overflow-x: auto; }
  }
</style>
