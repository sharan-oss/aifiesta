---
import { models } from '../data/content';
---
<section class="strip">
  <ul class="wrap strip__in">
    {models.map((m) => (
      <li>
        {m.name === 'Kimi'
          ? <span class="ic kimi" aria-hidden="true">K</span>
          : <img src={m.icon} alt="" width="28" height="28" loading="lazy" />}
        {m.name}
      </li>
    ))}
  </ul>
</section>
<style>
  .strip { background: #fff; padding-block: 32px; }
  .strip__in { display: grid; grid-template-columns: repeat(2, max-content); gap: 20px 40px; justify-content: center; }
  @media (min-width: 640px) { .strip__in { grid-template-columns: repeat(5, max-content); gap: 24px 48px; } }
  li { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  img { width: 28px; height: 28px; object-fit: contain; }
  .kimi { background: #1783ff; }
  .ic { width: 28px; height: 28px; border-radius: 8px; color: #fff; font: 700 13px/28px Inter, sans-serif; text-align: center; }
</style>
