---
import { models } from '../data/content';
import ModelItem from './ModelItem.astro';
import ModelsExplorer from './ModelsExplorer.astro';

// Mobile: three marquee rows, alternating direction and speed.
const rows = [models.slice(0, 4), models.slice(4, 7), models.slice(7)];
const motion = [
  { dir: 'normal', dur: '28s' },
  { dir: 'reverse', dur: '34s' },
  { dir: 'normal', dur: '30s' },
];
---
<section class="strip" aria-label="Supported AI models">
  <ModelsExplorer />
  <ul class="wrap grid">
    {models.map((m) => <li><ModelItem name={m.name} icon={m.icon} /></li>)}
  </ul>

  <div class="marquee" aria-hidden="true">
    {rows.map((row, i) => (
      <div class="row">
        <div class="track" style={`animation-direction:${motion[i].dir};animation-duration:${motion[i].dur}`}>
          {[0, 1].map(() => (
            <ul class="set">
              {[...row, ...row].map((m) => <li><ModelItem name={m.name} icon={m.icon} /></li>)}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .strip { background: #fff; padding-block: 28px; overflow: hidden; }

  /* Desktop grid */
  .grid { display: none; }

  /* Mobile marquee */
  .marquee { display: grid; gap: 20px; }
  .row { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; width: max-content; animation: scroll linear infinite; }
  .set { display: flex; gap: 40px; padding-right: 40px; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (min-width: 640px) {
    .strip { padding-block: 32px; }
    .marquee { display: none; }
    .grid { display: grid; grid-template-columns: repeat(5, max-content); gap: 24px 48px; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .row { overflow-x: auto; }
  }
</style>
