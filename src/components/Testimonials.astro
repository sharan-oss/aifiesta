---
import { testimonials } from '../data/content';
import Cta from './Cta.astro';
const star = '<path d="M12.1 15.4c-.2 0-.4-.1-.5-.2L8 12.6l-3.6 2.6c-.3.2-.7.2-1 0-.3-.2-.4-.6-.4-1l1.4-4.3L.8 7.4c-.3-.2-.4-.6-.3-1 .1-.4.4-.6.8-.6l4.4-.1 1.4-4.2C7.3 1.1 7.6.9 8 .9s.7.2.8.6l1.4 4.3 4.5.1c.4 0 .7.2.8.6.1.4 0 .8-.3 1l-3.6 2.5 1.4 4.4c.1.4 0 .8-.3 1-.2.1-.4.2-.6.2" fill="#FFAC33"/>';
---
<section class="section">
  <div class="wrap">
    <h2 class="title title--semi">Testimonials<i class="under"></i></h2>
    <p class="sub rating">10k+ User Reviews | 4.5 <svg viewBox="0 0 16 16" aria-hidden="true" set:html={star} /> Avg. Star Rating</p>
    <div class="bar"></div>
    <div class="slider">
      {testimonials.map((t) => (
        <figure>
          <div class="stars" aria-label="5 stars">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 16 16" aria-hidden="true" set:html={star} />)}</div>
          <blockquote>{t.text}</blockquote>
          <figcaption>
            <img src={t.img} alt={t.name} width="40" height="40" loading="lazy" />
            <div><b>{t.name}</b><span>{t.role}</span></div>
          </figcaption>
        </figure>
      ))}
    </div>
    <Cta />
  </div>
</section>
<style>
  .rating { margin-top: 12px; display: flex; justify-content: center; align-items: center; gap: 6px; flex-wrap: wrap; }
  .rating svg { width: 14px; height: 14px; }
  .slider { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; margin-block: 32px; padding-bottom: 4px; justify-content: safe center; }
  figure { margin: 0; flex: 0 0 min(100%, 420px); scroll-snap-align: center; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: grid; gap: 16px; }
  .stars { display: flex; gap: 2px; }
  .stars svg { width: 16px; height: 16px; }
  blockquote { margin: 0; font-size: 16px; color: rgba(3,0,37,.8); }
  figcaption { display: flex; align-items: center; gap: 20px; }
  figcaption img { width: 40px; height: 40px; border-radius: 50%; }
  figcaption div { display: grid; }
  figcaption b { color: var(--blue); font-size: 16px; }
  figcaption span { font-size: 12px; }
</style>
