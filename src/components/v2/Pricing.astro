---
import { CHECKOUT_HREF } from '../../data/content-v2';
import OfferTable from '../OfferTable.astro';
---
<section class="pricing" id="pricing">
  <div class="wrap">
    <h2 class="title">Everything You Get For <br /><span class="grad">Just ₹7,999/year</span></h2>
    <div class="card">
      <div class="head">
        <p class="name">AI Fiesta Basic</p>
        <span class="save">Save ₹3,989</span>
      </div>
      <p class="amt"><b class="grad">₹7,999</b><span>/year</span></p>
      <p class="per">Just ₹667/month, billed yearly</p>
      <a class="btn" href={CHECKOUT_HREF}>Get AI Fiesta <span aria-hidden="true">»</span></a>
      <OfferTable theme="dark">
        <p class="roll">
          <svg viewBox="0 0 23 23" fill="none" stroke="#80DCA9" stroke-width="1.725" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.9 9.6A9 9 0 0 1 17.3 3.8l2.8 2.9M20.1 1.9v4.8h-4.8M20.1 13.4a9 9 0 0 1-14.4 5.8l-2.8-2.9M2.9 21v-4.7h4.8" /></svg>
          All unused tokens roll over to next month. They never expire.
        </p>
      </OfferTable>
      <p class="foot"><s>₹11,988</s> · Save 33% with annual billing</p>
    </div>
  </div>
</section>
<style>
  .pricing { padding-block: 36px; border-bottom: 1px solid var(--line); }
  .title { margin-bottom: 28px; }
  .card { max-width: 480px; margin-inline: auto; background: var(--ink); color: #fff; border: 1px solid #35304c; border-radius: 20px; padding: 24px 20px; display: grid; gap: 10px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .name { font-family: var(--font-head); font-size: 24px; font-weight: 700; }
  .save { background: #110c36; border: 1px solid #35304c; border-radius: 30px; padding: 5px 10px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .amt { display: flex; align-items: baseline; gap: 12px; margin-top: 4px; }
  .amt b { font-family: var(--font-head); font-size: 44px; font-weight: 700; line-height: 1.2; }
  .amt span { color: #cbd0de; }
  .per { padding-bottom: 10px; }
  .card :global(.offer4x) { margin-top: 14px; }
  .roll { display: flex; gap: 10px; align-items: flex-start; color: #cbd0de; font-size: 15px; padding-left: 2px; }
  .roll svg { width: 23px; height: 23px; flex: none; margin-top: 2px; }
  .foot { text-align: center; font-size: 14px; color: #cbd0de; padding-top: 6px; }
  .foot s { color: #b1999a; }
  .btn { font-size: 18px; }
  @media (min-width: 768px) { .pricing { padding-block: 72px; } .card { padding: 32px 28px; } .title { margin-bottom: 40px; } }
</style>
