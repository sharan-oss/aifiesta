---
import { strip } from '../../data/content-v2';
const items = [...strip, ...strip, ...strip, ...strip];
---
<section class="strip">
  <h2 class="title">INCLUDED <span class="grad">AI MODELS</span><i class="under"></i></h2>
  <div class="bar bar--light"></div>
  <div class="track" aria-label="Included AI models">
    <ul>
      {items.map((m, i) => <li aria-hidden={i >= strip.length}><img src={m.src} alt={i < strip.length ? m.name : ''} width="152" height="67" loading="lazy" /></li>)}
    </ul>
  </div>
</section>
<style>
  .strip { background: var(--ink); padding-block: 32px; overflow: hidden; }
  .title { color: #fff; font-weight: 600; font-size: clamp(22px, 3.6vw, 32px); }
  .track { margin-top: 28px; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  ul { display: flex; gap: 16px; width: max-content; animation: scroll 28s linear infinite; }
  li { background: #fff; border-radius: 12px; width: 152px; height: 67px; overflow: hidden; flex: none; }
  li img { width: 100%; height: 100%; object-fit: cover; }
  @keyframes scroll { to { transform: translateX(calc(-25% - 4px)); } }
  @media (prefers-reduced-motion: reduce) { ul { animation: none; } }
</style>
