---
import Cta from './Cta.astro';
---
<section class="hero">
  <div class="wrap inner">
    <span class="pill"><i></i>One single subscription just ₹7,999/year</span>
    <h1>Access <span class="grad">100+ Premium</span> AI Models like <span class="grad">Claude, Gemini, Perplexity,</span> in one Subscription</h1>
    <p class="lead">More tools to explore, more ways to get work done, and one simple annual subscription.</p>
    <img src="/v2/hero.png" alt="Dhruv Rathee surrounded by AI app icons" width="631" height="568" fetchpriority="high" />
    <Cta at="hero" />
  </div>
</section>
<style>
  .hero { padding-block: 30px 36px; background: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(0,109,249,.06), transparent); }
  .inner { display: grid; justify-items: center; text-align: center; gap: 20px; }
  .pill { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 50px; background: rgba(0,109,249,.09); border: 1px solid rgba(0,109,249,.15); color: var(--blue); font-size: 11px; font-weight: 600; text-transform: uppercase; max-width: 100%; }
  .pill i { width: 11px; height: 11px; border-radius: 50%; background: var(--grad); box-shadow: 0 0 10px rgba(255,153,75,.7); flex: none; }
  h1 { font-size: clamp(30px, 6.4vw, 60px); line-height: 1.1; font-weight: 700; letter-spacing: -0.015em; max-width: 14em; }
  .lead { font-size: 14px; color: rgba(3,0,37,.8); max-width: 34em; }
  img { width: 100%; max-width: 520px; height: auto; }
  @media (min-width: 900px) {
    .hero { padding-block: 56px 72px; }
    .inner { grid-template-columns: 1.1fr 1fr; justify-items: start; text-align: left; column-gap: 48px; align-items: center; }
    .pill { grid-column: 1; }
    h1 { grid-column: 1; }
    .lead { grid-column: 1; font-size: 17px; }
    img { grid-column: 2; grid-row: 1 / span 4; justify-self: center; max-width: 560px; }
    .inner :global(.cta) { grid-column: 1; margin-inline: 0; }
    .inner :global(.offer) { text-align: left; }
  }
</style>
