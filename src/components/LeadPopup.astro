---
// Home B test: every checkout button opens this form first. It asks for the details Cashfree
// needs (so its form arrives pre-filled and shows just "Proceed to pay") plus two questions,
// saves them to the Sheet (/api/lead -> Leads tab), fires Meta Lead + AddToCart, then sends
// the buyer to the same Cashfree link the button had (UTMs already appended).
import { CHECKOUT_PREFIX, PLAN_VALUE, PLAN_CURRENCY, plan } from '../data/content';
import { PERSONAS, PURPOSES } from '../../lib/lead-options.js';
interface Props { variant?: string }
const { variant = 'b' } = Astro.props;
---
<dialog id="lead-popup" class="lp" aria-labelledby="lp-title">
  <form class="lp__card" novalidate>
    <button type="button" class="lp__x" aria-label="Close" data-close>×</button>
    <p class="lp__tag">Almost there · {plan.price}/year</p>
    <h2 id="lp-title">Tell us a little about you</h2>
    <p class="lp__sub">We'll fill these in on the secure payment page for you.</p>

    <div class="lp__grid">
      <label class="lp__f">Name<input name="name" autocomplete="name" required maxlength="100" /></label>
      <label class="lp__f">Phone<span class="lp__ph"><i>+91</i><input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="10" pattern="[6-9][0-9]{9}" /></span></label>
      <label class="lp__f">Email<input name="email" type="email" autocomplete="email" required maxlength="120" /></label>
      <label class="lp__f">Pincode<input name="pincode" inputmode="numeric" autocomplete="postal-code" required maxlength="6" pattern="[1-9][0-9]{5}" /></label>
    </div>

    <fieldset class="lp__q">
      <legend>What describes you best?</legend>
      <div class="lp__chips">{PERSONAS.map((p) => <label><input type="radio" name="persona" value={p} required /><span>{p}</span></label>)}</div>
    </fieldset>
    <fieldset class="lp__q">
      <legend>What will you mainly use AI Fiesta for?</legend>
      <div class="lp__chips">{PURPOSES.map((p) => <label><input type="radio" name="purpose" value={p} required /><span>{p}</span></label>)}</div>
    </fieldset>

    <label class="lp__consent"><input type="checkbox" name="consent" /> Send me updates and offers on WhatsApp and email</label>
    <p class="lp__err" role="alert" hidden></p>
    <button class="lp__go" type="submit">Continue to payment <span aria-hidden="true">→</span></button>
    <p class="lp__safe">Next: pay securely on Cashfree with UPI or card. Cancel anytime.</p>
  </form>
</dialog>

<script is:inline define:vars={{ checkoutPrefix: CHECKOUT_PREFIX, variant, value: PLAN_VALUE, currency: PLAN_CURRENCY }}>
  (function () {
    var dlg = document.getElementById('lead-popup');
    if (!dlg || !dlg.showModal) return;
    var form = dlg.querySelector('form'), err = dlg.querySelector('.lp__err');
    var href = '', cta = 'other';
    var SAVED = 'af_lead';

    function load() { try { return JSON.parse(localStorage.getItem(SAVED)) || {}; } catch (e) { return {}; } }
    function fill() {
      var s = load();
      ['name', 'phone', 'email', 'pincode'].forEach(function (k) { if (s[k] && !form.elements[k].value) form.elements[k].value = s[k]; });
    }

    // Capture phase on window: runs before the pixel's AddToCart click handler and stops it.
    window.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.href.indexOf(checkoutPrefix) !== 0) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault(); e.stopPropagation();
      href = a.href; cta = a.getAttribute('data-cta') || 'other';
      err.hidden = true; fill();
      dlg.showModal();
      if (window.clarity) clarity('event', 'LeadPopup_open_' + cta);
    }, true);

    dlg.addEventListener('click', function (e) {
      if (e.target === dlg || e.target.closest('[data-close]')) dlg.close();
    });

    form.addEventListener('input', function () { err.hidden = true; });
    form.addEventListener('change', function () { err.hidden = true; });

    function digits(v) { return String(v || '').replace(/\D/g, ''); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = form.elements;
      var phone = digits(f.phone.value).replace(/^(91|0)(?=\d{10}$)/, '');
      var d = {
        name: f.name.value.trim(), phone: phone, email: f.email.value.trim().toLowerCase(),
        pincode: digits(f.pincode.value), persona: (form.querySelector('[name=persona]:checked') || {}).value || '',
        purpose: (form.querySelector('[name=purpose]:checked') || {}).value || '', consent: f.consent.checked,
      };
      var problem = d.name.length < 2 ? 'Please enter your name.'
        : !/^[6-9]\d{9}$/.test(d.phone) ? 'Please enter a valid 10-digit mobile number.'
        : !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email) ? 'Please enter a valid email.'
        : !/^[1-9]\d{5}$/.test(d.pincode) ? 'Please enter your 6-digit pincode.'
        : !d.persona || !d.purpose ? 'Please answer both questions.' : '';
      if (problem) { err.textContent = problem; err.hidden = false; return; }

      try { localStorage.setItem(SAVED, JSON.stringify({ name: d.name, phone: d.phone, email: d.email, pincode: d.pincode })); } catch (x) {}
      var attr = {}; try { attr = JSON.parse(localStorage.getItem('af_attr')) || {}; } catch (x) {}
      var lead = Object.assign({}, d, attr.params || {}, {
        lead_id: 'L' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8), variant: variant,
        landing_lp: attr.landing_lp || '', landing_url: attr.landing_url || '', referrer: attr.referrer || '',
        landed_at: attr.landed_at ? new Date(attr.landed_at).toISOString() : '', page_url: location.href.slice(0, 500),
      });
      var body = JSON.stringify(lead), sent = false;
      try { sent = navigator.sendBeacon('/api/lead', new Blob([body], { type: 'text/plain' })); } catch (x) {}
      if (!sent) { try { fetch('/api/lead', { method: 'POST', body: body, keepalive: true }); } catch (x) {} }

      if (window.fbq) {
        fbq('track', 'Lead', { content_name: 'AI Fiesta yearly plan', persona: d.persona, purpose: d.purpose });
        fbq('track', 'AddToCart', { value: value, currency: currency, content_name: 'AI Fiesta yearly plan', cta: cta, variant: variant });
      }
      if (window.clarity) clarity('event', 'LeadPopup_submit');

      // Cashfree pre-fills fields whose title matches the param name exactly. It doesn't read
      // "+" as a space, so encode with %20 (encodeURIComponent), not URLSearchParams.
      var pre = [['Name', d.name], ['Phone Number', d.phone], ['Email ID', d.email], ['Pincode', d.pincode], ['lead_id', lead.lead_id]]
        .map(function (kv) { return encodeURIComponent(kv[0]) + '=' + encodeURIComponent(kv[1]); }).join('&');
      var url = href + (href.indexOf('?') === -1 ? '?' : '&') + pre;
      form.querySelector('.lp__go').disabled = true;
      setTimeout(function () { location.href = url; }, 250);
    });
  })();
</script>

<style>
  .lp { width: min(520px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 0; border: 0; border-radius: 20px; background: #fff; color: #100e24; box-shadow: 0 30px 80px -20px rgba(16, 14, 36, .45); }
  .lp::backdrop { background: rgba(16, 14, 36, .55); backdrop-filter: blur(3px); }
  .lp__card { position: relative; display: grid; gap: 11px; padding: 20px 16px 16px; }
  .lp__x { position: absolute; top: 8px; right: 10px; width: 36px; height: 36px; border: 0; background: none; font-size: 26px; line-height: 1; color: #6c6888; cursor: pointer; }
  .lp__tag { justify-self: start; padding: 4px 10px; border-radius: 99px; background: #f1ecff; color: #6a4dff; font-size: 12px; font-weight: 700; }
  .lp h2 { font-family: 'Manrope', 'Inter', sans-serif; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .lp__sub { margin-top: -6px; font-size: 13.5px; color: #6c6888; }
  .lp__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lp__f { display: grid; gap: 4px; font-size: 12.5px; font-weight: 600; color: #4a475f; }
  .lp__f input, .lp__ph { width: 100%; height: 42px; border: 1.5px solid #ddd6ed; border-radius: 10px; padding: 0 12px; font: 500 15px/1 'Inter', sans-serif; color: #100e24; background: #fff; }
  .lp__f input:focus, .lp__ph:focus-within { outline: none; border-color: #6a4dff; box-shadow: 0 0 0 3px rgba(106, 77, 255, .15); }
  .lp__ph { display: flex; align-items: center; gap: 6px; padding: 0 0 0 12px; }
  .lp__ph i { font-style: normal; color: #6c6888; }
  .lp__ph input { height: 100%; border: 0; padding: 0 12px 0 0; box-shadow: none !important; }
  .lp__q { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .lp__q legend { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
  .lp__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .lp__chips label { cursor: pointer; }
  .lp__chips input { position: absolute; opacity: 0; pointer-events: none; }
  .lp__chips span { display: inline-block; padding: 7px 11px; border-radius: 99px; border: 1.5px solid #ddd6ed; font-size: 12.5px; font-weight: 600; color: #4a475f; }
  .lp__chips input:checked + span { border-color: #6a4dff; background: #f1ecff; color: #4b33d6; }
  .lp__chips input:focus-visible + span { box-shadow: 0 0 0 3px rgba(106, 77, 255, .25); }
  .lp__consent { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; color: #4a475f; }
  .lp__consent input { margin-top: 2px; accent-color: #6a4dff; }
  .lp__err { font-size: 13px; font-weight: 600; color: #c62828; }
  .lp__go { height: 54px; border: 0; border-radius: 99px; background: linear-gradient(100deg, #7c4dff, #3d6bff 60%, #22b8ff); color: #fff; font: 800 16.5px/1 'Manrope', 'Inter', sans-serif; cursor: pointer; box-shadow: 0 16px 30px -16px rgba(61, 107, 255, .9); }
  .lp__go:disabled { opacity: .7; }
  .lp__safe { text-align: center; font-size: 12px; color: #6c6888; }
  @media (max-width: 380px) { .lp__grid { grid-template-columns: 1fr; } }
</style>
